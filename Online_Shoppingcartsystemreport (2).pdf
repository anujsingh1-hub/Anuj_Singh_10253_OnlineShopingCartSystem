) Tj T* (142      static final Map<String, Product> products = new HashMap<>\(\);) Tj T* (143      static final CartList cart = new CartList\(\);) Tj T* (144      static final NodeStack undoStack = new NodeStack\(\);) Tj T* (145      static Scanner sc;) Tj T* (146  ) Tj T* (147      // ---------- File handling ----------) Tj T* (148      static void loadProducts\(\) {) Tj T* (149          File file = new File\(PRODUCT_FILE\);) Tj T* (150          if \(!file.exists\(\)\) {) Tj T* (151              products.put\("P101", new Product\("P101", "Notebook", 50\)\);) Tj T* (152              products.put\("P102", new Product\("P102", "Pen", 10\)\);) Tj T* (153              products.put\("P103", new Product\("P103", "Bag", 800\)\);) Tj T* ET
