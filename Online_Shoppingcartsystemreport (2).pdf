BT 1 0 0 1 0 388.55 Tm /F4 6.3 Tf 7.45 TL (001  import java.io.*;) Tj T* (002  import java.time.LocalDateTime;) Tj T* (003  import java.util.*;) Tj T* (004  ) Tj T* (005  public class OnlineShoppingCart {) Tj T* (006  ) Tj T* (007      static final String PRODUCT_FILE = "products.txt";) Tj T* (008      static final String ORDER_FILE = "orders.txt";) Tj T* (009  ) Tj T* (010      // Product record stored as the value of the HashMap \(key = product ID\).) Tj T* (011      static class Product {) Tj T* (012          String id, name;) Tj T* (013          int price;) Tj T* (014          Product\(String id, String name, int price\) {) Tj T* (015              this.id = id;) Tj T* (016              this.name = name;) Tj T* (017              this.price = price;) Tj T* (018          }) Tj T* (019      }) Tj T* (020  ) Tj T* (021      // One line of the cart: a product and the quantity added in one operation.) Tj T* (022      static class CartItem {) Tj T* (023          Product product;) Tj T* (024          int quantity;) Tj T* (025          CartItem\(Product product, int quantity\) {) Tj T* (026              this.product = product;) Tj T* (027              this.quantity = quantity;) Tj T* (028          }) Tj T* (029          long total\(\) { return \(long\) product.price * quantity; }) Tj T* (030      }) Tj T* (031  ) Tj T* (032      // Node of the self-implemented singly linked list.) Tj T* (033      static class Node {) Tj T* (034          CartItem data;) Tj T* (035          Node next;) Tj T* (036          Node\(CartItem data\) { this.data = data; }) Tj T* (037      }) Tj T* (038  ) Tj T* (039      // Singly linked list that stores the cart \(insertion at tail is O\(1\)\).) Tj T* (040      static class CartList {) Tj T* (041          Node head, tail;) Tj T* (042          int size;) Tj T* (043  ) Tj T* (044          Node add\(CartItem item\) {) Tj T* (045              Node node = new Node\(item\);) Tj T* (046              if \(head == null\) head = tail = node;) Tj T* (047              else { tail.next = node; tail = node; }) Tj T* (048              size++;) Tj T* (049              return node;) Tj T* (050          }) Tj T* (051  ) Tj T* (052          boolean remove\(Node target\) {) Tj T* (053              if \(head == null || target == null\) return false;) Tj T* ET
